# Local development defaults. Replace credentials and BASE_URL outside local development.
DB_URL=jdbc:postgresql://localhost:5432/url_shortener
DB_USERNAME=url_shortener
DB_PASSWORD=url_shortener
DB_POOL_SIZE=10
DB_MIN_IDLE=2
DB_CONNECT_TIMEOUT_SECONDS=3
DB_SOCKET_TIMEOUT_SECONDS=10
DB_CANCEL_TIMEOUT_SECONDS=3
DB_QUERY_TIMEOUT_MS=5000
DB_LOCK_TIMEOUT_MS=3000

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false

SERVER_PORT=8080
BASE_URL=http://localhost:8080
MANAGEMENT_API_KEY=
MANAGEMENT_API_KEY_HEADER=X-API-Key
TRACING_SAMPLING_PROBABILITY=0.0
SHORT_CODE_LENGTH=8
SHORT_CODE_MAX_ATTEMPTS=5
URL_CACHE_TTL=24h

ANALYTICS_DISPATCH_BATCH_SIZE=100
ANALYTICS_DISPATCH_INTERVAL=250ms
ANALYTICS_RETENTION=90d
ANALYTICS_RETENTION_BATCH_SIZE=5000
ANALYTICS_RETENTION_MAX_BATCHES=10
ANALYTICS_RETENTION_CLEANUP_INTERVAL=1m

SHUTDOWN_TIMEOUT=45s
